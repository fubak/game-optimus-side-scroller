{
  "name": "optimus-red-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "OPTIMUS: RED PROTOCOL — a cinematic 2D action-platformer starring Tesla Optimus, running entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bake": "tsx tools/bake/run.ts",
    "capture": "tsx tools/capture/record.ts",
    "metrics": "tsx tools/metrics/scorecard.ts",
    "audit": "tsx tools/audit/run.ts",
    "progress": "tsx tools/progress/build.ts",
    "progress:serve": "vite preview --outDir progress --host 0.0.0.0 --port 5174",
    "gate": "npm run typecheck && npm run test && npm run audit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
